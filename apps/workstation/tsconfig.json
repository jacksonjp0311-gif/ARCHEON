{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@archeon/scene-engine": ["../../packages/scene-engine/src/index.ts"],
      "@archeon/spatial-grammar": ["../../packages/spatial-grammar/src/index.ts"],
      "@archeon/design-protocol": ["../../packages/design-protocol/src/index.ts"]
    }
  },
  "include": ["src"]
}
