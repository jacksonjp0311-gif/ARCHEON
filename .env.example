# ARCHEON environment — copy to .env (never commit secrets)

# API
ARCHEON_BIND=127.0.0.1:8799
ARCHEON_PROJECT=projects/archeon-arm
ARCHEON_CAD_PYTHON=python
ARCHEON_CAD_WORKER=workers/cad-occt

# AI provider (OpenAI-compatible). Application runs without a key.
# SpaceXAI / xAI default:
#   ARCHEON_AI_BASE_URL=https://api.x.ai/v1
#   ARCHEON_AI_MODEL=grok-4.5
#   ARCHEON_AI_API_KEY=   (or XAI_API_KEY)
ARCHEON_AI_BASE_URL=
ARCHEON_AI_API_KEY=
ARCHEON_AI_MODEL=grok-4.5
ARCHEON_AI_PROVIDER=mock

# Memory (local JSON). Cortex adapter is a documented stub, not wired.
ARCHEON_MEMORY_DIR=memory
